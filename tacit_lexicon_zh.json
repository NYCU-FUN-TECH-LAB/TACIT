  "patterns": {
    "ANT_P_conditional_future": {
      "dimension": "anticipation",
      "polarity": "P",
      "regex": "(如果|假如|萬一|要是|倘若)[^，。；]{2,30}(就|才|會|可能|也許)",
      "note": {
        "en": "Conditional clause plus modality; signals exploration of multiple futures.",
        "zh": "條件句＋情態，指向對多重未來的探索"
      }
    },
    "ANT_P_long_horizon": {
      "dimension": "anticipation",
      "polarity": "P",
      "regex": "(未來|以後|長期|再過)[^，。；]{0,6}(\\d+|幾|數)(年|個月|世代)",
      "note": {
        "en": "An explicit multi-year time horizon.",
        "zh": "明確的長期時間跨度"
      }
    },
    "ANT_P_uncertainty_acknowledged": {
      "dimension": "anticipation",
      "polarity": "P",
      "regex": "(很難|不太|無法|沒辦法)(說|預測|估|判斷|知道|保證)",
      "note": {
        "en": "Explicit admission that outcomes cannot be predicted.",
        "zh": "承認預測侷限，認知謙遜的預期"
      }
    },
    "ANT_N_determinism": {
      "dimension": "anticipation",
      "polarity": "N",
      "regex": "(一定|必然|肯定|絕對|勢必)(會|要|是|走向)",
      "note": {
        "en": "Single deterministic forecast; technological determinism.",
        "zh": "單一確定性預測，技術決定論語氣"
      }
    },
    "ANT_N_deferral": {
      "dimension": "anticipation",
      "polarity": "N",
      "regex": "(到時候|以後|之後|等)[^，。；]{0,8}(再說|再想|再處理|再看)",
      "note": {
        "en": "Postponing foresight until the technology has already stabilised.",
        "zh": "將前瞻延後，等技術定型才介入"
      }
    },
    "REF_P_epistemic_concession": {
      "dimension": "reflexivity",
      "polarity": "P",
      "regex": "(其實|老實說|坦白說|說實在)[^，。；]{0,20}(不確定|不敢|不知道|沒把握|也在想)",
      "note": {
        "en": "First-person epistemic humility.",
        "zh": "第一人稱認知謙遜"
      }
    },
    "REF_P_self_questioning": {
      "dimension": "reflexivity",
      "polarity": "P",
      "regex": "(我們|我)[^，。；]{0,10}(是不是|有沒有|會不會)[^，。；]{0,15}(錯|忽略|沒想到|不夠)",
      "note": {
        "en": "Second-order reflection on the speaker's own assumptions.",
        "zh": "對自身假設的二階反思"
      }
    },
    "REF_N_expert_authority": {
      "dimension": "reflexivity",
      "polarity": "N",
      "regex": "(我們|業界|工程師)[^，。；]{0,8}(最懂|最清楚|最專業|才知道)",
      "note": {
        "en": "We-know-best framing that excludes outside voices.",
        "zh": "we-know-best 框架"
      }
    },
    "REF_N_risk_denial": {
      "dimension": "reflexivity",
      "polarity": "N",
      "regex": "(不會|沒有|不可能)[^，。；]{0,8}(問題|風險|危險|疑慮)",
      "note": {
        "en": "Denial of risk or uncertainty; techno-optimism.",
        "zh": "技術樂觀、規避不確定性討論"
      }
    },
    "ENG_P_active_inclusion": {
      "dimension": "engagement",
      "polarity": "P",
      "regex": "(找|邀請|拉|請)[^，。；]{0,12}(一起|進來|參與|加入|討論)",
      "note": {
        "en": "Actively inviting external actors into the process.",
        "zh": "實質邀請外部行動者"
      }
    },
    "ENG_P_two_way_dialogue": {
      "dimension": "engagement",
      "polarity": "P",
      "regex": "(聽|收集|蒐集|徵詢)[^，。；]{0,8}(意見|回饋|想法|建議)",
      "note": {
        "en": "Two-way exchange rather than one-way communication.",
        "zh": "雙向溝通而非單向傳播"
      }
    },
    "ENG_N_downstream_notification": {
      "dimension": "engagement",
      "polarity": "N",
      "regex": "(定案|決定|確定|做完)(之?後|了)[^，。；]{0,10}(再|才)[^，。；]{0,8}(告知|知會|說明|溝通|公布)",
      "note": {
        "en": "Engagement reduced to notification after decisions are fixed.",
        "zh": "下游介入，參與淪為告知"
      }
    },
    "ENG_N_deficit_model": {
      "dimension": "engagement",
      "polarity": "N",
      "regex": "(民眾|一般人|外行|他們)[^，。；]{0,8}(不懂|聽不懂|不了解|沒概念)",
      "note": {
        "en": "Deficit-model framing of the public as incapable of understanding.",
        "zh": "缺乏模型（deficit model）語氣"
      }
    },
    "RES_P_causal_adjustment": {
      "dimension": "responsiveness",
      "polarity": "P",
      "regex": "(因為|由於|聽到|看到)[^，。；]{2,25}(所以|因此|於是)[^，。；]{0,15}(改|調整|修|停|換|重做)",
      "note": {
        "en": "Full causal chain from external signal to substantive change; the strongest evidence of responsiveness.",
        "zh": "外部訊號→實質改變的完整因果鏈，回應性最強證據"
      }
    },
    "RES_P_halt_decision": {
      "dimension": "responsiveness",
      "polarity": "P",
      "regex": "(決定|最後)[^，。；]{0,6}(不做|不推|喊停|終止|放棄)",
      "note": {
        "en": "Capacity to stop or withdraw an innovation trajectory.",
        "zh": "有能力終止創新軌跡"
      }
    },
    "RES_N_immutable_path": {
      "dimension": "responsiveness",
      "polarity": "N",
      "regex": "(不能|不會|沒辦法|來不及|改不)[^，。；]{0,4}(改|動|調整|回頭)",
      "note": {
        "en": "Rigid structure; the trajectory cannot be changed.",
        "zh": "剛性結構，obdurate"
      }
    },
    "RES_N_regulation_as_obstacle": {
      "dimension": "responsiveness",
      "polarity": "N",
      "regex": "(法規|法令|主管機關|政府)[^，。；]{0,10}(阻礙|限制|綁|跟不上|拖|卡)",
      "note": {
        "en": "Regulation framed as an obstacle rather than as material for co-governance.",
        "zh": "將規制視為障礙而非治理共構材料"
      }
    }
  }
}